DOCUMENT();

loadMacros(
  'PGstandard.pl',
  'PGML.pl',
  'PGcourse.pl',
  'contextArbitraryString.pl'
);

TEXT(beginproblem());

Context('ArbitraryString');

############################################################
# Binary covalent compounds only
############################################################

@covalent = (
    {
        formula => "CO",
        name    => "carbon monoxide",
    },
    {
        formula => "CO_2",
        name    => "carbon dioxide",
    },
    {
        formula => "N_2O",
        name    => "dinitrogen monoxide",
    },
    {
        formula => "NO",
        name    => "nitrogen monoxide",
    },
    {
        formula => "NO_2",
        name    => "nitrogen dioxide",
    },
    {
        formula => "N_2O_3",
        name    => "dinitrogen trioxide",
    },
    {
        formula => "N_2O_4",
        name    => "dinitrogen tetroxide",
    },
    {
        formula => "N_2O_5",
        name    => "dinitrogen pentoxide",
    },
    {
        formula => "SO_2",
        name    => "sulfur dioxide",
    },
    {
        formula => "SO_3",
        name    => "sulfur trioxide",
    },
    {
        formula => "SF_6",
        name    => "sulfur hexafluoride",
    },
    {
        formula => "PCl_3",
        name    => "phosphorus trichloride",
    },
    {
        formula => "PCl_5",
        name    => "phosphorus pentachloride",
    },
    {
        formula => "P_2O_5",
        name    => "diphosphorus pentoxide",
    },
    {
        formula => "Cl_2O",
        name    => "dichlorine monoxide",
    },
    {
        formula => "Cl_2O_7",
        name    => "dichlorine heptoxide",
    },
    {
        formula => "CCl_4",
        name    => "carbon tetrachloride",
    },
    {
        formula => "CS_2",
        name    => "carbon disulfide",
    },
    {
        formula => "SiO_2",
        name    => "silicon dioxide",
    },
    {
        formula => "SiCl_4",
        name    => "silicon tetrachloride",
    },
);

############################################################
# Randomization
############################################################

# Choose six binary covalent compounds.
@compounds = random_subset(6, @covalent);

############################################################
# Name checker
############################################################

sub normalize_name {
    my $s = shift;

    # lowercase
    $s = lc($s);

    # trim leading/trailing whitespace
    $s =~ s/^~~s+//;
    $s =~ s/~~s+$//;

    # collapse repeated spaces
    $s =~ s/~~s+/ /g;

    return $s;
}

sub name_checker {
    my ($correct, $student, $ansHash) = @_;

    my $c = normalize_name("$correct");
    my $s = normalize_name("$student");

    $ansHash->{ans_message} = "";

    return 1 if $c eq $s;

    # If they typed something formula-like in the name blank.
    if ($s =~ /[_~~d]/ || $s =~ /[A-Z][a-z]?/) {
        $ansHash->{ans_message} =
            "This blank asks for the compound name, not the formula.";
        return 0;
    }

    # Roman numerals should not be used for binary covalent compounds.
    if ($s =~ /~~([ivxlcdm]+~~)/i) {
        $ansHash->{ans_message} =
            "Do not use Roman numerals for binary covalent compounds. Use prefixes instead.";
        return 0;
    }

    # Mono is not used on the first element when there is only one atom.
    if ($s =~ /^mono/) {
        $ansHash->{ans_message} =
            "Do not use mono- on the first element. For example, CO is carbon monoxide, not monocarbon monoxide.";
        return 0;
    }

    # Common oxide spelling issues.
    if ($s =~ /monooxide/) {
        $ansHash->{ans_message} =
            "Drop the extra vowel in monooxide. Use monoxide.";
        return 0;
    }

    if ($s =~ /pentaoxide/) {
        $ansHash->{ans_message} =
            "Drop the extra vowel in pentaoxide. Use pentoxide.";
        return 0;
    }

    if ($s =~ /tetraoxide/) {
        $ansHash->{ans_message} =
            "Drop the extra vowel in tetraoxide. Use tetroxide.";
        return 0;
    }

    # Binary covalent names usually have two words.
    if ($s !~ /~~s/) {
        $ansHash->{ans_message} =
            "A binary covalent compound name should include both element names. Use prefixes to show the number of atoms.";
        return 0;
    }

    $ansHash->{ans_message} =
        "Check the prefixes and the ending of the second element. The second element should end in -ide.";
    return 0;
}

############################################################
# Formula checker
############################################################

sub normalize_formula {
    my $f = shift;

    # Remove whitespace
    $f =~ s/~~s+//g;

    return $f;
}

sub formula_checker {
    my ($correct, $student, $ansHash) = @_;

    my $c = normalize_formula("$correct");
    my $s = normalize_formula("$student");

    $ansHash->{ans_message} = "";

    return 1 if $c eq $s;

    # Do not include phase labels.
    if ($s =~ /~~((aq|s|l|g)~~)$/i) {
        $ansHash->{ans_message} =
            "Do not include a phase label. Enter only the chemical formula.";
        return 0;
    }

    # Student entered something name-like.
    if ($s =~ /~~s/ || $s =~ /^[a-z]/) {
        $ansHash->{ans_message} =
            "This blank asks for the formula, not the compound name.";
        return 0;
    }

    # Binary covalent formulas should not use parentheses.
    if ($s =~ /[()]/) {
        $ansHash->{ans_message} =
            "Do not use parentheses for these binary covalent formulas.";
        return 0;
    }

    # Must use underscores for subscripts.
    # Examples: CO2 should be CO_2; N2O5 should be N_2O_5.
    if ($s =~ /(?<!_)~~d+/) {
        $ansHash->{ans_message} =
            "Use an underscore for subscripts. For example, write CO_2, not CO2, and N_2O_5, not N2O5.";
        return 0;
    }

    # Invalid characters.
    if ($s =~ /[^A-Za-z0-9_]/) {
        $ansHash->{ans_message} =
            "The formula contains invalid characters. Use element symbols and underscores for subscripts.";
        return 0;
    }

    $ansHash->{ans_message} =
        "Check the prefixes in the name. The subscripts in a binary covalent formula come directly from the prefixes and should not be reduced.";
    return 0;
}

@formula_ans = ();
@name_ans    = ();

for my $i (0..$#compounds) {
    my $p = $compounds[$i];

    $formula_ans[$i] = String($p->{formula})->cmp(checker => ~~&formula_checker);
    $name_ans[$i]    = String($p->{name})->cmp(checker => ~~&name_checker);
}

############################################################
# PGML
############################################################

BEGIN_PGML

## Formulas and Names of Binary Covalent Compounds

Complete the table by filling in the missing **formula** or **name** for each binary covalent compound.

- Use prefixes to show the number of atoms in the formula.
- Do not use mono- on the first element.
- The second element ends in -ide.
- Use an underscore character for subscripts. For example, type [`\mathrm{CO_2}`], not [`\mathrm{CO2}`].
- Do not reduce subscripts in binary covalent formulas. For example, [`\mathrm{N_2O_4}`] is named dinitrogen tetroxide.

[#
[.Formula.]
[.Name.]*{ headerrow => 1 }

[.[`\mathrm{CO_2}`].]
[.carbon dioxide.]*

[.[___]{$formula_ans[0]}.]
[.[$compounds[0]{name}].]*

[.[`\mathrm{[$compounds[1]{formula}]}`].]
[.[___]{$name_ans[1]}.]*

[.[___]{$formula_ans[2]}.]
[.[$compounds[2]{name}].]*

[.[`\mathrm{[$compounds[3]{formula}]}`].]
[.[___]{$name_ans[3]}.]*

[.[___]{$formula_ans[4]}.]
[.[$compounds[4]{name}].]*

[.[`\mathrm{[$compounds[5]{formula}]}`].]
[.[___]{$name_ans[5]}.]*

#]{align => '|l|l|', horizontalrules => 1}

END_PGML

############################################################
# Hint
############################################################

BEGIN_PGML_HINT

1. Binary covalent compounds use prefixes to show how many atoms of each element are present.

2. Do not use mono- on the first element. For example, [`\mathrm{CO}`] is carbon monoxide, not monocarbon monoxide.

3. The second element name ends in -ide. For example, oxygen becomes oxide and chlorine becomes chloride.

4. The subscripts come directly from the prefixes. Do not reduce the formula.

END_PGML_HINT

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION

[#
[.Formula.]
[.Name.]*{ headerrow => 1 }

[.[`\mathrm{[$compounds[0]{formula}]}`].][.[$compounds[0]{name}].]*
[.[`\mathrm{[$compounds[1]{formula}]}`].][.[$compounds[1]{name}].]*
[.[`\mathrm{[$compounds[2]{formula}]}`].][.[$compounds[2]{name}].]*
[.[`\mathrm{[$compounds[3]{formula}]}`].][.[$compounds[3]{name}].]*
[.[`\mathrm{[$compounds[4]{formula}]}`].][.[$compounds[4]{name}].]*
[.[`\mathrm{[$compounds[5]{formula}]}`].][.[$compounds[5]{name}].]*

#]{align => '|c|c|', horizontalrules => 1}

END_PGML_SOLUTION

ENDDOCUMENT();
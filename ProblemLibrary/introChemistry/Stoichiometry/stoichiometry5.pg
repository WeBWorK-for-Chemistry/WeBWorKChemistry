## Institution(PCC)
## Author(Lee McPherson, Stephanie Bryan)

##############################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PGcourse.pl",
  "answerHints.pl",
  "niceTables.pl",
  "parserPopUp.pl",
  "contextInexactValue.pl",
  "contextInexactValueWithUnits.pl",
  "contextChemical.pl",  # added for chemical parsing in units
  "parserDimensionalAnalysis.pl",
  "parserMultiAnswer.pl",
  "weightedGrader.pl"
);

##############################################


install_weighted_grader();

Context("Numeric");

$m = random(1.01 ,9.99, 0.01);
$moles = $m*0.01;
$sigFigAns = 3;

Context("InexactValueWithUnits")->flags->set('hasChemicals' => 1);  # flag needed to recognize chemical names as units


   
    $given = InexactValueWithUnits( [$moles , 3], 'moles K_3P'); 
    
    $n1 = InexactValueWithUnits(['2', 9**9**9], 'mol O_2'); 
    $d1 = InexactValueWithUnits(['1', 9**9**9], 'mol K_3P'); 
    
    $n2 = InexactValueWithUnits(['32.00', 4], 'g O_2'); 
    $d2 = InexactValueWithUnits(['1', 9**9**9], 'mol O_2');

$answer = $given * $n1 / $d1 * $n2 / $d2;

# To create a dimensional analysis problem, first put all of the expected answer blanks into the MultiAnswer section.
# These need to be numerator, then denominator... in that pattern exactly.  You end it with a precalculated answer because
# we expect students to fill in that blank, too.
# Finally, instead of customizing your own MultiAnswer, call the asDimensionalAnalysis function and provide it the starting value for the 
# actual dimensional analysis.  A second parameter will adjust how the scoring is done.

$ma = MultiAnswer($n1,$d1,$n2,$d2,$answer)->asDimensionalAnalysis($given, {creditSigFigsGiven => 0.25,
creditValueGiven   => 0.75,

creditSigFigsFinal => 0.30,
creditValueFinal   => 0.50,
creditUnitsFinal   => 0.20,

messageDigitsDiff => "Your numerical value is close. Check that you are using the correct coefficents from the balanced equation and/or that the molar masses are rounded to the hundredths place.",
messageDigitsDiffAns => "This problem specifies that the answer should be rounded to $sigFigAns significant figures."});

# use the conversionEQ below by filling in the starting value, an array of the conversion factor blanks, then the final answer blank.

$dimensionalAnalysisSolution = DimensionalAnalysis::generateExplanation([$given],[$n1,$d1,$n2,$d2],$answer);
##############################################
#Calculate the mass in grams of [`[$given]`] of [`[@'~~mathrm{' . $compound . '} '@]`].  


TEXT(beginproblem());

BEGIN_PGML

##Stoichiometry: Moles to Mass

Calculate the mass in grams of [``\mathrm{O_2}``] needed to react with [$moles] moles of [``\mathrm{K_3P}``] according to the chemical equation given. 
    
* Use [@ htmlLink( protect_underbar("https://spot.pcc.edu/chemistry/periodic-table/?maxPrecision=2&minDecimals=2"), protect_underbar("this linked periodic table"), "TARGET='_blank'" ); @]*  to find the molar mass needed.  Use molar masses rounded to the nearest hundredth.

* Report your final answer to 3 sig figs and don't forget to include units.

[``` \ce{K_3P + 2O_2 \rightarrow K_3PO_4} ```]


[#
    [.[`[$given]`] .]
    [.[`\times`].]

    [.
        [#
            [.[_]{$ma}[<divided by>]{[
                'span',
                style => 'position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;'
            ]}{['%', "\n"]}.]*{bottom => 1}
            [.[_]{$ma} .]*
        #]*
    .]
    [.[`\times`].]
    [.
        [#
            [.[_]{$ma}[<divided by>]{[
                'span',
                style => 'position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;'
            ]}{['%', "\n"]}.]*{bottom => 1}
            [.[_]{$ma} .]*
        #]*
    .]

    [.[`=`].]
    [.[_]{$ma}.]
#]*{valign => 'middle'}

END_PGML


# This weights the final answer with X percentage and splits the rest among the conversion factors.
my $finalAnswerWeight = 50;
my $remain = 100-$finalAnswerWeight;
my @ansArr = $ma->cmp();
my $finalAns = pop @ansArr;
for ($i=0; $i<scalar @ansArr; $i++){
	WEIGHTED_ANS($ansArr[$i], $remain/(scalar @ansArr)); # sets weighting for dimensional analysis blanks
}
WEIGHTED_ANS($finalAns, $finalAnswerWeight); # sets weighting for final answer

# Without weighting, you could simply use this:
# ANS($ma->cmp);
# each answer blank will be worth the same amount of points.

##############################################



BEGIN_PGML_HINT

Solving a Mole-to-Mass Problem

1. Identify the “given” information in the problem: Look for the starting number of moles and the specific chemical identity provided (e.g., "2.5 moles of A"). This is the number you will start your calculation with.

2. What is the problem asking you to “find”? Identify the new chemical and look for the keyword "mass" or "grams". Your final answer will have the unit grams [``\mathrm{O_2}``].

3. Use ratios and conversion factors to cancel out units: This will require two steps in your dimensional analysis grid:

        First, use the mole ratio from the balanced equation to convert from moles of your given chemical (put this on the bottom to cancel it) to moles of your target chemical (on top).

        Second, use the molar mass of your target chemical (calculated from the periodic table) to convert from moles (on the bottom) to grams (on top).

4. When your units cancel out correctly, you are ready to do the math: You should be left with only grams of your target chemical. Multiply your starting number by all the numbers on the top of your fractions, and divide by any numbers on the bottom.


For more information on mole to mass conversion, click [@ htmlLink( protect_underbar("https://chem.libretexts.org/Courses/Portland_Community_College/CH151%3A_Preparatory_Chemistry/10%3A_Mass_Relations_in_Chemical_Reactions/10.03%3A_Mole-to-Mass_Mass-to-Mole_and_Mass-to-Mass_Conversions"), protect_underbar("here"), "TARGET='_blank'" ); @]*


END_PGML_HINT
##############################################

BEGIN_PGML_SOLUTION

[```[$dimensionalAnalysisSolution]```]


END_PGML_SOLUTION

ENDDOCUMENT();


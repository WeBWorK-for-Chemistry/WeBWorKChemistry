DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl",
"PGchoicemacros.pl",
"unionTables.pl",
);

TEXT(beginproblem());

######################################


Context("Numeric");
$showPartialCorrectAnswers = 1;

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"A" => "A", "B" => "B", "C" => "C", 
"D" => "D", "E" => "E", "F" => "F",
"G" => "G", "H" => "H", "I" => "I",
]);

#
#  Add correct questions and answers
#
$ml->qa(
"A solution that resists large changes in pH when small amounts of acid or base are added.", "buffer","An acid that only partially ionizes in water.", "weak acid",
"The species formed when an acid loses a proton.", "conjugate base",
"The amount of acid or base a buffer can neutralize before its pH changes substantially.", "buffer capacity",
"A proton-transfer reaction in which an acid reacts with a base.", "neutralization",
);
$ml->choose(5);

#
#  Add extra incorrect answers
#
$ml->extra(
"added acid",
"weak base", 
);
$ml->choose_extra(2);
  
#$ml->makeLast("None of the above");


######################################


BEGIN_PGML
## Buffer Matching

Match the phrase on the left with the best symbol or concept that it describes on the right.

[@ ColumnMatchTable($ml,valign => TOP) @]* 



END_PGML


######################################

ANS( str_cmp( $ml->ra_correct_ans ) );


ENDDOCUMENT();

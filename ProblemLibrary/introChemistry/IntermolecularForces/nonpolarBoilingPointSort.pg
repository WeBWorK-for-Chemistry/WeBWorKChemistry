## DBsubject(Chemistry)
## DBchapter(Intermolecular Forces)
## DBsection(Boiling Point)
## Level()
## KEYWORDS('intermolecular forces', 'boiling point', 'London dispersion forces', 'nonpolar molecules')
## Author('Stephanie Bryan')
## Institution(PCC)
## Language(en-US)

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl",
  "parserPopUp.pl"
);

TEXT(beginproblem());

############################################################
# Predefined boiling point comparison sets
#
# Each set has one highest, one middle, and one lowest.
#
# These examples focus on nonpolar substances.
#
# Main idea:
#   larger particle / more electrons / greater polarizability
#   -> stronger London dispersion forces
#   -> higher boiling point
############################################################

@sets = (
  [
    {
      formula      => "I_2",
      formulaHTML  => "I<sub>2</sub>",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "I2 is the largest molecule in this set and has the most electrons, so it has the strongest London dispersion forces and the highest boiling point.",
    },
    {
      formula      => "Br_2",
      formulaHTML  => "Br<sub>2</sub>",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "Br2 is larger than Cl2 but smaller than I2, so its London dispersion forces are in the middle for this set.",
    },
    {
      formula      => "Cl_2",
      formulaHTML  => "Cl<sub>2</sub>",
      rank         => "lowest",
      rankNumber   => "3 - lowest boiling point",
      reason       => "Cl2 is the smallest molecule in this set and has the weakest London dispersion forces, so it has the lowest boiling point.",
    },
  ],

  [
    {
      formula      => "Br_2",
      formulaHTML  => "Br<sub>2</sub>",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "Br2 is larger than Cl2 and F2, so it has the strongest London dispersion forces and the highest boiling point.",
    },
    {
      formula      => "Cl_2",
      formulaHTML  => "Cl<sub>2</sub>",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "Cl2 is larger than F2 but smaller than Br2, so its London dispersion forces are in the middle for this set.",
    },
    {
      formula      => "F_2",
      formulaHTML  => "F<sub>2</sub>",
      rank         => "lowest",
      rankNumber   => "3 - lowest boiling point",
      reason       => "F2 is the smallest molecule in this set and has the weakest London dispersion forces, so it has the lowest boiling point.",
    },
  ],

  [
    {
      formula      => "Xe",
      formulaHTML  => "Xe",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "Xe is the largest atom in this set and has the most electrons, so it has the strongest London dispersion forces and the highest boiling point.",
    },
    {
      formula      => "Kr",
      formulaHTML  => "Kr",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "Kr is larger than Ar but smaller than Xe, so its London dispersion forces are in the middle for this set.",
    },
    {
      formula      => "Ar",
      formulaHTML  => "Ar",
      rank         => "lowest",
      rankNumber   => "3 - lowest boiling point",
      reason       => "Ar is the smallest atom in this set and has the weakest London dispersion forces, so it has the lowest boiling point.",
    },
  ],

  [
    {
      formula      => "Kr",
      formulaHTML  => "Kr",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "Kr is the largest atom in this set and has the strongest London dispersion forces, so it has the highest boiling point.",
    },
    {
      formula      => "Ar",
      formulaHTML  => "Ar",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "Ar is larger than Ne but smaller than Kr, so its London dispersion forces are in the middle for this set.",
    },
    {
      formula      => "Ne",
      formulaHTML  => "Ne",
      rank         => "lowest",
      rankNumber   => "3 - lowest boiling point",
      reason       => "Ne is the smallest atom in this set and has the weakest London dispersion forces, so it has the lowest boiling point.",
    },
  ],

  [
    {
      formula      => "CBr_4",
      formulaHTML  => "CBr<sub>4</sub>",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "CBr4 is the largest molecule in this set and has the most electrons, so it has the strongest London dispersion forces and the highest boiling point.",
    },
    {
      formula      => "CCl_4",
      formulaHTML  => "CCl<sub>4</sub>",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "CCl4 is larger than CF4 but smaller than CBr4, so its London dispersion forces are in the middle for this set.",
    },
    {
      formula      => "CF_4",
      formulaHTML  => "CF<sub>4</sub>",
      rank         => "lowest",
      rankNumber   => "3 - lowest boiling point",
      reason       => "CF4 is the smallest molecule in this set and has the weakest London dispersion forces, so it has the lowest boiling point.",
    },
  ],

  [
    {
      formula      => "CS_2",
      formulaHTML  => "CS<sub>2</sub>",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "CS2 is larger and has more electrons than CO2 and N2, so it has the strongest London dispersion forces in this set.",
    },
    {
      formula      => "CO_2",
      formulaHTML  => "CO<sub>2</sub>",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "CO2 is larger and has more electrons than N2, but smaller than CS2, so its London dispersion forces are in the middle.",
    },
    {
      formula      => "N_2",
      formulaHTML  => "N<sub>2</sub>",
      rank         => "lowest",
      rankNumber   => "3 - lowest boiling point",
      reason       => "N2 is the smallest molecule in this set and has the weakest London dispersion forces, so it has the lowest boiling point.",
    },
  ],

  [
    {
      formula      => "SiH_4",
      formulaHTML  => "SiH<sub>4</sub>",
      rank         => "highest",
      rankNumber   => "1 - highest boiling point",
      reason       => "SiH4 is larger and has more electrons than CH4 and Ne, so it has the strongest London dispersion forces in this set.",
    },
    {
      formula      => "CH_4",
      formulaHTML  => "CH<sub>4</sub>",
      rank         => "middle",
      rankNumber   => "2 - middle boiling point",
      reason       => "CH4 is larger than Ne but smaller than SiH4, so its London dispersion forces are in the middle for this set.",
    },
    {
